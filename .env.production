# build-time env for production (Vercel runs `vite build`, which picks
# this up and embeds the values). Activates the opt-in client error
# reporter (src/modules/errorTelemetry.ts) — the collector is a PostgREST
# table on the production api (see
# sql/apflora/migrations/2026-11-13_error-telemetry/)
VITE_ERROR_TELEMETRY_URL=https://api.apflora.ch/postgrest/error_report
