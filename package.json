{
  "name": "apflora",
  "description": "Aktionspläne für Flora-Projekte",
  "private": true,
  "version": "1.137.58",
  "versionDate": "14.11.2026",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/barbalex/apf2.git"
  },
  "author": "Alexander Gabriel",
  "license": "ISC",
  "overrides": {
    "leaflet": "$leaflet",
    "next": "16.4.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "cross-env NODE_ENV=dev playwright test",
    "test:ui": "cross-env NODE_ENV=dev playwright test --ui",
    "test:headed": "cross-env NODE_ENV=dev playwright test --headed",
    "test-report": "playwright show-report",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "bump": "node scripts/bumpVersion.mjs",
    "deploy": "node scripts/deploy.mjs",
    "how-to-install-using-sfw": "sfw npm i",
    "ncu using cooldown": "ncu -c 5 -i",
    "postinstall": "node scripts/patch-leaflet2.mjs",
    "models:generate": "node scripts/kanel-generate.mjs",
    "selects:generate": "node scripts/generate-selects.mjs",
    "db:apply-sql": "scripts/apply-postgrest-sql.sh",
    "test:api": "vitest run --config vitest.config.api.ts"
  },
